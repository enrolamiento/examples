# Su usuario del portal de clientes: el RUT de su empresa, con guion y dígito verificador.
ENROLAMIENTO_USUARIO=
# La «Llave de acceso» de Mi Cuenta > Integración. Trátela como una contraseña.
ENROLAMIENTO_APIKEY=
# El secreto de firma de Mi Cuenta > Notificaciones (webhook-receiver y mini-erp).
ENROLAMIENTO_WEBHOOK_SECRETO=

# Solo mini-erp.
# El secreto de la suscripción a respaldo.finalizado, si la tiene. Opcional.
ENROLAMIENTO_WEBHOOK_SECRETO_RESPALDO=
# La marca del ERP de ejemplo, también en el widget. El color va como #RRGGBB y entre comillas: sin
# ellas, el .env lee el # como el inicio de un comentario. Otro valor se ignora.
MINI_ERP_NOMBRE="Andes ERP"
MINI_ERP_COLOR="#1D4ED8"
# prueba (sesiones de prueba) o real.
MINI_ERP_MODO=prueba
