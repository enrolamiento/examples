# Su usuario del portal de clientes: el RUT de su empresa, con guion y dígito verificador.
ENROLAMIENTO_USUARIO=
# La «Llave de acceso» de Mi Cuenta > Integración. Trátela como una contraseña.
ENROLAMIENTO_APIKEY=
# El secreto de firma de Mi Cuenta > Notificaciones (webhook-receiver y mini-erp). Para probar en su
# máquina sirve cualquier texto: el CLI del SDK firma con este mismo valor.
ENROLAMIENTO_WEBHOOK_SECRETO=

# Solo mini-erp.
# El secreto de la suscripción a respaldo.finalizado, si la tiene. Opcional: sin él, la ruta
# /webhooks/respaldo responde 404. Para probarla con el CLI, use el mismo valor de arriba.
ENROLAMIENTO_WEBHOOK_SECRETO_RESPALDO=
# La marca del ERP de ejemplo, también en el widget. El nombre, hasta 60 caracteres. El color va
# como #RRGGBB y entre comillas: sin ellas, el .env lee el # como el inicio de un comentario. Otro
# valor se ignora.
MINI_ERP_NOMBRE="Andes ERP"
MINI_ERP_COLOR="#1D4ED8"
# prueba (sesiones de prueba y «Simular el aviso») o real. Cualquier otro valor es prueba.
MINI_ERP_MODO=prueba
# Dónde se guarda lo importado. Por omisión, mini-erp/datos/, fuera de git.
# MINI_ERP_DATOS=

# El puerto de los servidores de ejemplo. Por omisión, 3000. npm run mini-erp:aviso apunta siempre
# al 3000.
# PUERTO=3000
